# The stacks engine helper: a privileged, short-lived container that owns every mount and every
# write to stacks. mkcomposefs compiles dumps to EROFS; util-linux does the mounts (and attaches
# loop devices on kernels without file-backed EROFS). Build from this directory:
#   docker build -f Dockerfile.helper -t avocado-stacks:dev .
FROM docker.io/library/fedora:44 AS build
RUN dnf -y install --setopt=install_weak_deps=False cargo rust gcc && dnf clean all
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src src
RUN cargo build --release --locked

FROM docker.io/library/fedora:44
LABEL org.opencontainers.image.source=https://github.com/avocado-linux/avocado-cli
RUN dnf -y install --setopt=install_weak_deps=False composefs util-linux-core && dnf clean all
COPY --from=build /src/target/release/avocado-stacks /usr/local/bin/avocado-stacks
ENTRYPOINT ["/usr/local/bin/avocado-stacks"]
